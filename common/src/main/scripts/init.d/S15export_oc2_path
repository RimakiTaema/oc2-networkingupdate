#!/bin/sh

THIS_SCRIPT_PATH=$(readlink -f "$0")
THIS_SCRIPT_DIR=$(dirname "$THIS_SCRIPT_PATH")
SOURCE_PATH=$(readlink -f "$THIS_SCRIPT_DIR/../bin")
STAGE_PATH="/run/oc2/bin"

start() {
    [ -d "$SOURCE_PATH" ] || return 0
    mkdir -p "$STAGE_PATH" 2>/dev/null || return 0
    cp "$SOURCE_PATH/oc2pkg" "$STAGE_PATH/oc2pkg" 2>/dev/null || return 0
    chmod 755 "$STAGE_PATH/oc2pkg" 2>/dev/null || true
    mkdir -p /etc/profile.d
    printf 'export PATH="%s:$PATH"\n' "$STAGE_PATH" > /etc/profile.d/oc2_path.sh
    return 0
}

stop() { rm -f /etc/profile.d/oc2_path.sh "$STAGE_PATH/oc2pkg"; return 0; }
reload() { stop; start; }

case "${1:-}" in
    start|stop|reload) "$1" ;;
    restart) reload ;;
    *) echo "Usage: $0 {start|stop|reload|restart}"; exit 1 ;;
esac
